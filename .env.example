# Neon → Dashboard → Connect → pilih "Pooled connection"
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Password buat login ke web app (sekali per device)
APP_PASSWORD=ganti-pake-password-panjang

# URL hasil deploy Vercel, tanpa slash di belakang
APP_URL=https://streak-ega.vercel.app

# Dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Chat ID lo sendiri (chat /start ke bot setelah setup buat dapetin angkanya)
TELEGRAM_CHAT_ID=
# String acak bebas, dipakai Telegram buat ngebuktiin webhook beneran dari Telegram (A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=ganti-string-acak

# String acak, dipakai cron-job.org / Vercel Cron & endpoint setup
CRON_SECRET=ganti-string-acak-lain
